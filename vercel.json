{
  "services": {
    "frontend": {
      "root": "front-end/tabuleiro_sudoku",
      "framework": "vite"
    },
    "backend": {
      "root": "back-end",
      "entrypoint": "sudoku_api:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}